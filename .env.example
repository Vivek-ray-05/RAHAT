# Copy this to backend/.env and fill in real values. Never commit backend/.env.

DATABASE_URL=postgresql+psycopg://rahat:rahat@localhost:5432/rahat
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

DEV_MODE=true

CORS_ORIGINS=http://localhost:5173

# Optional — leave blank to disable that channel/provider
BREVO_API_KEY=
BREVO_FROM_EMAIL=
GROK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
