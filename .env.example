# Local dev: copy this to backend/.env and fill in real values.
# Never commit backend/.env.
#
# Railway deploy: don't copy this file there. DATABASE_URL and
# REDIS_URL are injected automatically the moment you attach Railway's
# managed Postgres/Redis plugins to the backend service (reference
# them as ${{Postgres.DATABASE_URL}} / ${{Redis.REDIS_URL}} in the
# service's Variables tab, or Railway does it for you if offered) --
# set everything below that manually as service Variables instead. See
# README.md's Deployment section for the full list and what each one
# needs to be in production.

DATABASE_URL=postgresql+psycopg://rahat:rahat@localhost:5432/rahat
REDIS_URL=redis://localhost:6379/0

# Generate a real one for any non-local deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the placeholder below outside local dev.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Must be false for any real deployment -- the app refuses to start if
# DEV_MODE=true and CORS_ORIGINS doesn't look like localhost, so this
# is enforced, not just a convention.
DEV_MODE=true

# Comma-separated, no wildcard. Set this to your real deployed
# frontend URL(s) in production (e.g. https://rahat.up.railway.app).
CORS_ORIGINS=http://localhost:5173

# Optional — leave blank to disable that channel/provider
BREVO_API_KEY=
BREVO_FROM_EMAIL=
GROK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
