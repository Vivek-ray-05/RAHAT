# Copy this to backend/.env and fill in real values. Never commit backend/.env.

DATABASE_URL=postgresql+psycopg://rahat:rahat@localhost:5432/rahat

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

DEV_MODE=true

CORS_ORIGINS=http://localhost:5173

# Optional — leave blank to disable that channel/provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
