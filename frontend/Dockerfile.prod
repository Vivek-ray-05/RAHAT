# Production image: a real `vite build` served as static files, not
# the dev server used by docker-compose (see ./Dockerfile for that).
#
# VITE_API_BASE_URL/VITE_WS_URL get baked into the built JS at *build*
# time -- Vite replaces import.meta.env.VITE_* with literal values
# during `vite build`, unlike `vite dev` which reads them live. That
# means these have to be passed as Docker build args, not just
# container-runtime env vars, or the deployed app will silently point
# at whatever they defaulted to when the image was built. On Railway,
# set them as build-time variables on the frontend service.
FROM node:20-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_WS_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_WS_URL=$VITE_WS_URL

RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
